# Copy to .env, edit locally, then load with: set -a; source .env; set +a
# .env is ignored by Git. Never put a real key in this example file.
RRB_BASE_URL=http://127.0.0.1:18017/v1
RRB_MODEL=Qwen/Qwen2-VL-7B-Instruct
# Leave empty for a local model server without authentication.
# For a hosted API, set a private key locally and use its HTTPS base URL.
RRB_API_KEY=
# Optional: a local model directory, used only by tools/serve_qwen.py.
# RRB_MODEL_PATH=/path/to/Qwen2-VL-7B-Instruct
# Optional: YOLO11 checkpoint and inference device for CONFIG9.
# RRB_YOLO_WEIGHTS=/path/to/yolo11n.pt
# RRB_YOLO_DEVICE=cpu
